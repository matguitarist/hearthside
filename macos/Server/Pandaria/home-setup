#!/bin/bash
# The Pandaria server's setup on a home server, detached from the launcher that copied this folder
# and the client's Data folder here: the server built from source (a few hours on a small CPU), its
# databases, the maps read from the client, then the first start. A step already done (an image
# built, a database installed, maps read) is skipped, so a setup can run again. `.setup-step` holds
# the step in progress, then `.setup-done` or `.setup-failed`; the output goes to `setup.log`.
set -euo pipefail
cd "$(dirname "$0")"
echo $$ > .setup-pid
rm -f .setup-done .setup-failed
trap '[ -f .setup-done ] || touch .setup-failed; rm -f .setup-pid' EXIT
dc() { ./home-compose "$@"; }
step() { echo "$1" > .setup-step; echo "== $(date '+%F %T') $1"; shift; "$@"; }
build() { docker image inspect azeroth-survivors-pandaria:1 >/dev/null 2>&1 || docker buildx build --load -t azeroth-survivors-pandaria:1 .; }
# The dashboard does without them, should they fail.
worldmaps() { dc --profile tools run --rm -T worldmaps || echo "no world maps for the dashboard"; }
maps() { ls storage/data/maps 2>/dev/null | grep -q '\.map$' || dc --profile tools run --rm -T extract; }
# The other server takes the same ports: it stops for this one.
other() { [ ! -x ../azeroth-survivors-cmangos/home-compose ] || ../azeroth-survivors-cmangos/home-compose stop realmd mangosd database; }
if [ -d /mnt/user/appdata ]; then chown -R nobody:users . 2>/dev/null || true; fi
mkdir -p storage/logs storage/data storage/extract
step "Building the server from source (a few hours)…" build
step "Building the databases…" dc --profile tools run --rm -T install
step "Reading the maps from the game files…" maps
step "Drawing the dashboard's world maps…" worldmaps
step "Stopping the Classic server…" other
step "Starting the server and making its bots…" dc up -d database authserver worldserver
touch .setup-done
echo "== $(date '+%F %T') done"
