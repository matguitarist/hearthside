#!/bin/bash
# `docker compose` for the Forever server's folder on a home server, as `../Pandaria/home-compose` is
# for that one: the server's own, or the docker:cli image's where it has none (Unraid).
set -euo pipefail
cd "$(dirname "$0")"
p=hearthside-forever
f=(-p "$p" -f compose.yaml)
d=$PWD
# `.env`: the LAN address (the first of the host's), and the world's port on it, from 8105 up to the
# first free one (the Classic and Pandaria servers hold 8085 to 8087). Chosen once.
touch .env
if ! grep -q '^LAN_IP=' .env; then
    echo "LAN_IP=$(hostname -I 2>/dev/null | awk '{print $1}' || ip -4 route get 1 | awk '{print $7}')" >>.env
fi
if ! grep -q '^WORLD_PORT=' .env; then
    port=8105
    while ss -Hltn "sport = :$port" 2>/dev/null | grep -q .; do port=$((port + 1)); done
    echo "WORLD_PORT=$port" >>.env
fi
if docker compose version >/dev/null 2>&1; then
    docker compose "${f[@]}" "$@"
else
    docker run --rm -i -v /var/run/docker.sock:/var/run/docker.sock -v "$d:$d" -w "$d" docker:29-cli \
        docker compose "${f[@]}" "$@"
fi

# Unraid's autostart list, kept as the other servers keep it: an `up` puts the containers it names
# on it (the database first, with time to open), a `stop` or `down` takes them off.
list=/var/lib/docker/unraid-autostart
if [[ -f $list ]]; then
    case " $* " in
    " up "*)
        named=" $(printf '%s ' "$@" | sed -e 's/^up //' -e 's/-[^ ]* //g') "
        for c in "$p-database-1 10" "$p-worldserver-1" "$p-bnetserver-1" "$p-chat-1" "$p-ollama-1"; do
            s=${c#"$p-"}; s=${s%%-1*}
            [[ $named == "  " || $named == *" $s "* ]] || continue
            grep -q "^${c%% *}\( \|$\)" "$list" || echo "$c" >>"$list"
        done
        ;;
    *" stop "* | *" down "*)
        sed -i "/^$p-/d" "$list"
        ;;
    esac
fi
