#!/bin/bash
# A Battle.net account on the home server's Forever realm, from this Mac: `forever-account [--gm] [host]`.
#
# The server makes it (`bnetaccount create` over SOAP, inside the server's network): Battle.net
# accounts keep an SRP6 v2 verifier this script does not compute. The password goes over SSH to that
# one request and is kept nowhere. SOAP signs in as HEARTHSIDE, an administrator game account made
# here the first time: its random password lives in the server's `storage/soap-password` (root only),
# its salt and verifier (TrinityCore's Grunt SRP6: g = 7, little-endian numbers) go in by SQL.
set -euo pipefail
[ -t 0 ] || { echo "$(basename "$0") asks for a password: run it in Terminal" >&2; exit 1; }
gm=0
[[ ${1:-} == --gm ]] && { gm=3; shift; }
host=${1:-192.168.40.210}
key=~/.ssh/id_ed25519_homeserver
remote=/mnt/cache/appdata/azeroth-survivors-forever
p=azeroth-survivors-forever
on_server() { ssh -i "$key" "root@$host" "$@"; }
sql() { on_server docker exec -i $p-database-1 mysql -uroot -ppassword -N -B auth 2>/dev/null; }

read -rp "Email: " email
[[ $email =~ ^[^@[:space:]]+@[^@[:space:]]+$ ]] || { echo "not an email address" >&2; exit 1; }
read -rsp "Password: " pass; echo
read -rsp "Again: " again; echo
[[ $pass == "$again" ]] || { echo "the passwords differ" >&2; exit 1; }
[[ ${#pass} -ge 4 && ${#pass} -le 16 ]] || { echo "4 to 16 characters" >&2; exit 1; }
unset again

if ! on_server test -s "$remote/storage/soap-password"; then
    echo "making the SOAP account…"
    soap=$(openssl rand -hex 8)
    values=$(SOAP=$soap python3 -I -c '
import hashlib, os
N = int("894B645E89E1535BBDAD5B8B290650530801B18EBFBF5E8FAB3C82872A3E9BB7", 16)
user, password = "HEARTHSIDE", os.environ["SOAP"].upper()
salt = os.urandom(32)
x = int.from_bytes(hashlib.sha1(salt + hashlib.sha1(f"{user}:{password}".encode()).digest()).digest(), "little")
verifier = pow(7, x, N).to_bytes(32, "little")
print("0x" + salt.hex() + ", 0x" + verifier.hex())')
    sql <<SQL
DELETE a, x FROM account a LEFT JOIN account_access x ON x.AccountID = a.id WHERE a.username = 'HEARTHSIDE';
INSERT INTO account (username, salt, verifier, expansion) VALUES ('HEARTHSIDE', $values, 0);
INSERT INTO account_access (AccountID, SecurityLevel, RealmID) SELECT id, 3, -1 FROM account WHERE username = 'HEARTHSIDE';
SQL
    on_server "umask 077; cat > '$remote/storage/soap-password'" <<<"$soap"
    unset soap
fi

# The request, escaped for XML, on the server's standard input: never in a command line.
envelope=$(EMAIL=$email PASS=$pass python3 -I -c '
import os
from xml.sax.saxutils import escape
command = escape("bnetaccount create " + os.environ["EMAIL"] + " " + os.environ["PASS"])
print(f"""<?xml version="1.0" encoding="utf-8"?>
<SOAP-ENV:Envelope xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/" xmlns:ns1="urn:TC">
<SOAP-ENV:Body><ns1:executeCommand><command>{command}</command></ns1:executeCommand></SOAP-ENV:Body>
</SOAP-ENV:Envelope>""")')
unset pass
answer=$(on_server "docker run --rm -i --network ${p}_default curlimages/curl:8.11.1 -sS \
    -u \"HEARTHSIDE:\$(cat '$remote/storage/soap-password')\" -H 'Content-Type: text/xml' \
    --data-binary @- http://worldserver:7878/" <<<"$envelope")
unset envelope
result=$(sed -n 's:.*<result>\(.*\)</result>.*:\1:p; s:.*<faultstring>\(.*\)</faultstring>.*:\1:p' <<<"$answer")
echo "${result:-$answer}"
grep -qi 'created' <<<"$result" || exit 1

if ((gm)); then
    sql <<SQL
REPLACE INTO account_access (AccountID, SecurityLevel, RealmID)
SELECT a.id, $gm, -1 FROM account a JOIN battlenet_accounts b ON a.battlenet_account = b.id WHERE b.email = UPPER('${email//\'/\'\'}');
SQL
    echo "game master"
fi
