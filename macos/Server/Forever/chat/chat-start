#!/bin/bash
# The chat container's start. Always: the bot bridge's report for the dashboard every minute
# (`bridge-report`: spending, conversations, the bots' problems). With AI_CHAT=1: the bots module's
# chat program on the bridge's folder (/bridge, shared with the worldserver), answering for the
# bots with the model `.env` names.
#
#   AI_CHAT=1            the bots talk through a model; anything else: fixed lines, as before
#   ANTHROPIC_API_KEY    Claude, through claude-relay (AI_CHAT_MODEL, AI_CHAT_DAILY_USD: see there)
#   AI_CHAT_URL          or: an OpenAI-style service instead, an Ollama on the LAN for one
#                        (http://192.168.x.y:11434/v1), with AI_CHAT_MODEL its model (llama3.2:3b)
#   AI_CHAT_TALK         the world bots' talk among themselves: 0 their written lines, 1 the local
#                        model (the compose file's `ollama`, AI_CHAT_TALK_MODEL), 2 the chat model
#   AI_CHAT_ACTIONS      0: the bots only talk, a reply never makes them act
set -euo pipefail

# The worldserver makes the folder when its bridge starts.
until [ -f /bridge/status.json ]; do sleep 5; done

(while true; do bridge-report --json /bridge/report.json >/dev/null 2>&1 || true; sleep 60; done) &

if [ "${AI_CHAT:-0}" != 1 ]; then
    echo "AI_CHAT is off: the bots answer with their fixed lines"
    wait
fi

args=(--workers "${AI_CHAT_WORKERS:-4}" --log /bridge/program.log)
[ "${AI_CHAT_ACTIONS:-1}" = 1 ] || args+=(--no-actions)

if [ -n "${AI_CHAT_URL:-}" ]; then
    exec python3 -u /opt/chat/bot_bridge_ollama.py /bridge "${args[@]}" --url "$AI_CHAT_URL" --model "${AI_CHAT_MODEL:-llama3.2:3b}"
fi
if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    echo "AI_CHAT=1 but neither ANTHROPIC_API_KEY nor AI_CHAT_URL is set: fixed lines" >&2
    wait
fi

# The talk's local model: downloaded once into the ollama service's volume.
if [ "${AI_CHAT_TALK:-0}" = 1 ]; then
    export TALK_URL=http://ollama:11434/v1 TALK_MODEL=${AI_CHAT_TALK_MODEL:-llama3.2:1b}
    until curl -fsS http://ollama:11434/api/version >/dev/null 2>&1; do sleep 5; done
    if ! curl -fsS http://ollama:11434/api/tags | grep -q "\"$TALK_MODEL\""; then
        echo "downloading $TALK_MODEL for the bots' talk…"
        curl -fsS http://ollama:11434/api/pull -d "{\"model\":\"$TALK_MODEL\",\"stream\":false}" >/dev/null ||
            echo "couldn't download $TALK_MODEL: the talk keeps its written lines" >&2
    fi
fi

export RELAY_PORT=8411
claude-relay &
# While the relay can't answer, the program gives the bots' fixed lines.
exec python3 -u /opt/chat/bot_bridge_ollama.py /bridge "${args[@]}" \
    --url "http://127.0.0.1:$RELAY_PORT/v1" --model "${AI_CHAT_MODEL:-claude-haiku-5-5}"
