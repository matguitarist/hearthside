#!/bin/bash
# `docker compose` for this folder on a home server (`compose.lan.yaml` on top): the server's own,
# or the docker:cli image's where it has none (Unraid). The launcher runs everything through it.
set -euo pipefail
cd "$(dirname "$0")"
p=azeroth-survivors-cmangos
f=(-p "$p" -f compose.yaml -f compose.lan.yaml)
d=$PWD
# The world's port on the host, `WORLD_PORT` in `.env`: 8085, the game's own, unless something
# else on the server holds it (CrowdSec's API does by default), then the next free one. Chosen once.
touch .env
if ! grep -q '^WORLD_PORT=' .env; then
    port=8085
    while ss -Hltn "sport = :$port" 2>/dev/null | grep -q .; do port=$((port + 1)); done
    echo "WORLD_PORT=$port" >>.env
fi
port=$(sed -n 's/^WORLD_PORT=//p' .env)
if docker compose version >/dev/null 2>&1; then
    docker compose "${f[@]}" "$@"
else
    docker run --rm -i -v /var/run/docker.sock:/var/run/docker.sock -v "$d:$d" -w "$d" docker:29-cli \
        docker compose "${f[@]}" "$@"
fi

# The realm list tells clients the port: kept in step with WORLD_PORT after an `up`.
if [[ " $* " == " up "* ]]; then
    docker exec $p-database-1 mariadb -umangos -pmangos classicrealmd -e "UPDATE realmlist SET port = $port;" 2>/dev/null || true
fi

# Unraid stops every container with `docker stop` when Docker shuts down, which `unless-stopped`
# takes for a stop by hand, and starts only what its autostart list names: after an `up`, the
# containers it names (all, if none) go on that list, the database first with time to open before
# the others; a `stop` takes the game's off, so a server stopped from the launcher stays stopped,
# and a `down` all of them. The dashboard stays on through a stop.
list=/var/lib/docker/unraid-autostart
if [[ -f $list ]]; then
    case " $* " in
    " up "*)
        named=" $(printf '%s ' "$@" | sed -e 's/^up //' -e 's/-[^ ]* //g') "
        for c in "$p-database-1 10" "$p-realmd-1" "$p-mangosd-1" "$p-dashboard-1"; do
            s=${c#"$p-"}; s=${s%%-1*}
            [[ $named == "  " || $named == *" $s "* ]] || continue
            grep -q "^${c%% *}\( \|$\)" "$list" || echo "$c" >>"$list"
        done
        ;;
    *" stop "*)
        sed -i -e "/^$p-database-1/d" -e "/^$p-realmd-1/d" -e "/^$p-mangosd-1/d" "$list"
        ;;
    *" down "*)
        sed -i "/^$p-/d" "$list"
        ;;
    esac
fi
